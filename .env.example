MYSQL_USER=warrantyvault
MYSQL_PASSWORD=choose-a-local-password
# Generate a unique secret with `make secret`.
APP_JWT_SECRET=
APP_COOKIE_SECURE=false
APP_SEED_DEMO_DATA=false
APP_STORAGE_PROVIDER=local
# Production only: set SPRING_PROFILES_ACTIVE=prod, DB_URL, MYSQL_USER,
# MYSQL_PASSWORD, APP_STORAGE_PROVIDER=cloudinary, and CLOUDINARY_URL.
SPRING_PROFILES_ACTIVE=
DB_URL=
CLOUDINARY_URL=
# Set a private, unique password before running `make demo`.
APP_DEMO_PASSWORD=
